{
  "identifier": "document",
  "description": "ローカル文書ウィンドウの限定されたIPC。fs/shell/window作成権限を与えない。",
  "local": true,
  "windows": ["doc-*"],
  "permissions": [
    "allow-document-commands",
    "allow-app-updates",
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
